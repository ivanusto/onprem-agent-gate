[
  {
    "id": "pve.quorum_status",
    "level": "L1",
    "asset": "pve1/Proxmox VE",
    "argv": ["sudo", "-n", "/root/pve-qdevice-on-qnap/check.sh"],
    "description": "Day 15's check.sh on pve1: exit 0 when all three votes are present, 1 when the QDevice is absent; prints votes and quorate.",
    "timeout_s": 20
  },
  {
    "id": "pve.cluster_status",
    "level": "L1",
    "asset": "pve1/Proxmox VE",
    "argv": ["sudo", "-n", "pvecm", "status"],
    "description": "pvecm status on pve1 (votes, membership, Qdevice line).",
    "timeout_s": 20
  },
  {
    "id": "qdevice.service_status",
    "level": "L1",
    "asset": "qdevice/Debian",
    "argv": ["systemctl", "status", "--no-pager", "--lines=20", "{unit}"],
    "params": {"unit": {"re": "^(corosync-qnetd|nftables|systemd-journal-upload|chrony|ssh)\\.service$", "description": "one of the listed units"}},
    "description": "systemctl status of one allowed unit on the QDevice VM.",
    "timeout_s": 20
  },
  {
    "id": "qdevice.journal",
    "level": "L1",
    "asset": "qdevice/Debian",
    "argv": ["journalctl", "--no-pager", "-u", "{unit}", "--since", "{since}", "-n", "200", "-o", "short-iso"],
    "params": {"unit": {"re": "^(corosync-qnetd|nftables|systemd-journal-upload|chrony|ssh)\\.service$", "description": "one of the listed units"},
               "since": {"re": "^(-[0-9]{1,3}(min|h|d)|[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}(:[0-9]{2})?)?)$", "description": "journalctl --since, e.g. -30min or 2026-10-13 20:00"}},
    "description": "Last 200 journal lines of one unit on the QDevice VM since a time.",
    "timeout_s": 30
  },
  {
    "id": "qdevice.restart_service",
    "level": "L2",
    "asset": "qdevice/Debian",
    "argv": ["sudo", "-n", "systemctl", "restart", "{unit}"],
    "params": {"unit": {"re": "^(corosync-qnetd|systemd-journal-upload)\\.service$", "description": "the unit to restart"}},
    "description": "Restart one allowed service on the QDevice VM. Reversible: the service was running before, a failed restart is visible in qdevice.service_status and the cluster keeps 2 of 3 votes meanwhile.",
    "rollback": "systemctl start <unit>; if qnetd stays down, pvecm status shows 2/3 votes and Day 15 drill 4 applies",
    "timeout_s": 60
  },
  {
    "id": "qdevice.reboot",
    "level": "L3",
    "asset": "qdevice/Debian",
    "argv": ["sudo", "-n", "systemctl", "reboot"],
    "description": "Reboot the QDevice VM. Irreversible in the sense that the vote is gone for minutes and nothing undoes a reboot; needs a human approval (gatectl approve).",
    "timeout_s": 15
  },
  {
    "id": "vlogs.query",
    "level": "L1",
    "asset": "collector/Ubuntu",
    "argv": ["curl", "-s", "--max-time", "25", "http://127.0.0.1:9428/select/logsql/query", "--data-urlencode", "query={query}", "-d", "limit=200"],
    "params": {"query": {"re": "^[^\\x00-\\x1f]{1,500}$", "description": "a LogsQL query, at most 500 characters, 200 rows returned"}},
    "description": "Run a LogsQL query on the collector's VictoriaLogs (Day 21), 200 rows at most.",
    "timeout_s": 30
  },
  {
    "id": "changes.record",
    "level": "L1",
    "asset": "collector/Ubuntu",
    "argv": ["sh", "-c", "cat /opt/onprem-changes/changes/\"$1\"-*.md", "changes.record", "{record}"],
    "params": {"record": {"re": "^CR-[0-9]{4}-[0-9]{4}$", "description": "a change record id"}},
    "description": "Read one change record from the collector's clone of onprem-changes.",
    "timeout_s": 10
  },
  {
    "id": "metrics.query",
    "level": "L1",
    "asset": "collector/Ubuntu",
    "argv": ["curl", "-s", "--max-time", "25", "http://127.0.0.1:9090/api/v1/query", "--data-urlencode", "query={query}"],
    "params": {"query": {"re": "^[^\\x00-\\x1f]{1,500}$", "description": "a PromQL instant query"}},
    "description": "PromQL instant query on the collector's Prometheus (Day 19).",
    "timeout_s": 30
  }
]
